{
  "name": "@zysec-ai/relata-sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for the Relata data engine — ontology-driven, enterprise-grade workloads",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    },
    "./adapters/llamaindex": {
      "types": "./dist/adapters/llamaindex.d.ts",
      "import": "./dist/adapters/llamaindex.js"
    },
    "./adapters/langgraph": {
      "types": "./dist/adapters/langgraph.d.ts",
      "import": "./dist/adapters/langgraph.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relata": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "keywords": [
    "relata",
    "data-engine",
    "ontology",
    "enterprise",
    "bi-temporal",
    "graph"
  ],
  "author": "ZySec AI",
  "license": "Apache-2.0",
  "homepage": "https://relatadb.dev",
  "bugs": {
    "url": "https://github.com/relatadb/sdk-typescript/issues"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@types/node": "^25.9.0",
    "langchain": "^1.5.4",
    "llamaindex": "^0.12.1",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph-checkpoint": "^1.0.0",
    "langchain": "^1.0.0",
    "llamaindex": "^0.12.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": { "optional": true },
    "@langchain/langgraph-checkpoint": { "optional": true },
    "langchain": { "optional": true },
    "llamaindex": { "optional": true }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/relatadb/sdk-typescript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
