{
  "name": "@relata/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Relata data engine — ontology-driven, enterprise-grade workloads",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "relata": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "keywords": [
    "relata",
    "data-engine",
    "ontology",
    "enterprise",
    "bi-temporal",
    "graph"
  ],
  "author": "Relata contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/relata/relata"
  }
}
