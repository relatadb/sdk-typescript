{
  "name": "@zysec-ai/relata-sdk",
  "version": "0.2.8",
  "description": "TypeScript SDK for the Relata data engine — ontology-driven, enterprise-grade workloads",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relata": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "keywords": [
    "relata",
    "data-engine",
    "ontology",
    "enterprise",
    "bi-temporal",
    "graph"
  ],
  "author": "Relata contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OpenWorkBench-Co/RelataDB/tree/develop/sdks/typescript",
  "bugs": {
    "url": "https://github.com/OpenWorkBench-Co/RelataDB/issues"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWorkBench-Co/RelataDB",
    "directory": "sdks/typescript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
